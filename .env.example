# === 论文智助 环境变量 ===
# 复制此文件为 .env 并填入真实值

# 去 AI 味引擎（无需外部 API，离线可用）
# 无需配置，默认启用

# 百度翻译 API（可选，不配置则翻译功能返回 503）
# 注册地址：https://fanyi-api.baidu.com/
# 高级版：100万字符/月、QPS 10、单次6000字符
# 标准版：5万字符/月、QPS 1、单次1000字符
BAIDU_APPID=your_appid_here
BAIDU_SECRET=your_secret_here
BAIDU_PLAN=advanced

# Semantic Scholar API（可选，不配置则自动降级到 arXiv 免鉴权源）
# 申请地址：https://api.semanticscholar.org/
SEMANTIC_SCHOLAR_KEY=your_key_here

# DeepSeek 大模型（可选，用于规则引擎未命中时的开放性问答兜底）
# 注册地址：https://platform.deepseek.com/
# 不配置则问答只走规则引擎，开放性闲聊不可用
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 服务器
HOST=0.0.0.0
PORT=8000